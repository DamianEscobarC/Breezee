<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/breeze_background"
    android:padding="28dp">

    <LinearLayout
        android:id="@+id/layoutLogin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <TextView
            android:id="@+id/txtTituloLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:text="Breeze"
            android:letterSpacing="-0.03"
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="@color/breeze_text_primary" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="36dp"
            android:text="Calcula y reduce tu huella urbana."
            android:textSize="15sp"
            android:textColor="@color/breeze_text_secondary" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Correo institucional"
            android:textSize="13sp"
            android:textColor="@color/breeze_text_secondary" />

        <EditText
            android:id="@+id/edtUsuario"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/input_background"
            android:hint="usuario@santotomas.cl"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="16dp"
            android:textColor="@color/breeze_text_primary"
            android:textColorHint="@color/breeze_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Contraseña"
            android:textSize="13sp"
            android:textColor="@color/breeze_text_secondary" />

        <EditText
            android:id="@+id/edtClave"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/input_background"
            android:hint="••••••••"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:textColor="@color/breeze_text_primary"
            android:textColorHint="@color/breeze_text_secondary"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/chkRecordarme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Mantener sesión abierta"
            android:textColor="@color/breeze_text_secondary"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnIngresar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/btn_primary"
            android:text="Entrar"
            android:textAllCaps="false"
            android:textColor="#0B0F17"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtIrARegistro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:minHeight="48dp"
            android:text="¿No tienes cuenta? Regístrate aquí"
            android:textColor="@color/breeze_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>